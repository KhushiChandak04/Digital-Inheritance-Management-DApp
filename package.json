{
  "name": "digital-inheritance-dapp",
  "version": "1.0.0",
  "description": "Blockchain-based digital inheritance management prototype",
  "scripts": {
    "compile": "truffle compile",
    "migrate": "truffle migrate --reset",
    "test": "truffle test",
    "ganache:heirloom": "npx ganache --server.port 7545 --database.dbPath ./.ganache-heirloom --wallet.deterministic",
    "frontend:check": "node scripts/check-frontend.cjs",
    "frontend:build": "npm run frontend:check",
    "frontend:serve": "npx http-server frontend -p 4173 -c-1"
  },
  "devDependencies": {
    "truffle": "^5.11.5",
    "@openzeppelin/test-helpers": "^0.5.16"
  }
}
